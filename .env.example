PORT=3000

# --- MySQL --------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306            # XAMPP / WAMP / MySQL installer: 3306   |   MAMP: 8889
DB_USER=root
DB_PASSWORD=
DB_NAME=lms_final_database

# --- Login tokens ---------------------------------------------------------
# Use a long random value, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_secret_here
JWT_EXPIRES_IN=1d

# --- Frontend on a DIFFERENT address (Live Server, Vite...) --------------------
# Comma-separated. Leave empty while your pages are served from /public (same origin).
# CORS_ORIGIN=http://127.0.0.1:5500,http://localhost:5173

# --- HTTPS (optional) - set BOTH to turn it on. See docs/CONNECT_AND_TEST.md ---
# SSL_KEY_PATH=certs/key.pem
# SSL_CERT_PATH=certs/cert.pem
